[Unit]
Description=Sync RSS, reports, hot stories and selected changes to a private reader cache
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/intelligence-hub/aihot-private-reader/upstream_reader.py --cache-dir /opt/intelligence-hub/aihot-private-reader/cache --admin-export-dir /opt/intelligence-hub/aihot/private-reader-api
ExecStartPost=/usr/bin/docker compose -p muqiao-intel -f /opt/intelligence-hub/aihot/app/docker-compose.yml -f /opt/intelligence-hub/aihot/app/compose.override.yaml exec -T api node scripts/reconcile-upstream-reviews.ts
TimeoutStartSec=12min
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/opt/intelligence-hub/aihot-private-reader /opt/intelligence-hub/aihot/private-reader-api
StandardOutput=journal
StandardError=journal
