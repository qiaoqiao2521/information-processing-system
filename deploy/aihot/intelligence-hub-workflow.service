[Unit]
Description=Information processing workflow: subscriptions, event grouping and upstream review
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/information-processing-system
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock -n %t/intelligence-hub-workflow.lock /usr/bin/python3 tools/aihot/workflow.py
TimeoutStartSec=25min
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal
